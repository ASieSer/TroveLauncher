# --- Python ---------------------------------------------------------------
# El bytecode se regenera solo y depende de la versión de Python de cada uno:
# versionarlo sólo produce conflictos en cada commit.
__pycache__/
*.py[cod]
*.egg-info/

# Entornos virtuales. En Linux se crean con --system-site-packages (ver README),
# así que el de cada uno es distinto y ninguno debe viajar en el repositorio.
.venv/
venv/
env/

# --- Productos de construcción --------------------------------------------
# De PyInstaller, si alguna vez se congela la aplicación.
/build/
/dist/
*.spec

# OJO: native/troveinject.exe SÍ se versiona, aunque sea un binario. Quien juega
# en Linux no tiene por qué tener un compilador cruzado; la fuente está al lado
# y tools/build_helper.sh lo reproduce.

# --- Editores y sistema ---------------------------------------------------
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
